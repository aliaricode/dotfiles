# Ignore Wallust generated files

.config/alacritty/colors.toml
.config/btop/themes/wallust.theme
.config/hypr/lua/colors.lua
.config/gtk-3.0/gtk-colors.css
.config/gtk-4.0/gtk-colors.css
.config/wallust/wallust.json
.config/cava/themes/wallust-colors
.config/quickshell/bar/theme.json

# ignore stuff related to monitors

.config/hypr/monitors.conf
.config/hypr/monitors.lua
.config/hypr/workspaces.conf
.config/hypr/workspaces.lua

#ignore wallpapers
wallpapers

# calendar location (secrets live in ~/.local/share/quickshell/secrets)
.config/quickshell/bar/popups/calendar/weather.json

# legacy secret locations, kept ignored in case an old copy is left behind
.config/quickshell/scripts/credentials.json
.config/quickshell/scripts/token.json
.config/quickshell/scripts/spotify_credentials.json
.config/quickshell/scripts/spotify_token.json

# machine-local state
.config/fish/fish_variables

# editor/tool backups
*.bak
